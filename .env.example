# Copiar a `.env` y ajustar con las URLs reales que entregue el equipo de backend.

# Base de la API REST del backend
VITE_API_URL=http://localhost:8080

# URL del WebSocket de chat
VITE_WS_URL=ws://localhost:8080/ws

# Título de la app (opcional)
VITE_APP_TITLE=Chat

# WebSocket simulado en memoria mientras no haya backend real.
# "true" (por defecto) usa el mock; "false" usa el WebSocket real (VITE_WS_URL).
VITE_WS_MOCK=true
