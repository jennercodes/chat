# Copiar a `.env` y ajustar con las URLs del backend (Spring).

# Base de la API REST del backend. El navegador llama aquí directo con Bearer,
# así que el backend debe permitir CORS para el origen del frontend.
VITE_API_URL=http://localhost:8080

# URL del WebSocket de chat (handshake con ?ticket=<t>).
VITE_WS_URL=ws://localhost:8080/ws

# Título de la app (opcional)
VITE_APP_TITLE=Chat
